{
  "name": "cutline-contracts",
  "private": true,
  "type": "module",
  "scripts": {
    "compile": "hardhat compile && node scripts/gen-abi.mjs && node scripts/gen-vault-abi.mjs",
    "abi": "node scripts/gen-abi.mjs && node scripts/gen-vault-abi.mjs",
    "typecheck": "tsc --noEmit",
    "test": "hardhat test",
    "deploy:testnet": "tsx scripts/deploy.ts bscTestnet",
    "addresses": "tsx scripts/addresses.ts",
    "deploy:vault": "tsx scripts/deploy-vault.ts",
    "deploy:fund": "tsx scripts/deploy-fund.ts",
    "seed:fund": "tsx scripts/seed-fund.ts",
    "abi:fund": "hardhat compile && node scripts/gen-fund-abi.mjs"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ignition": "^0.15.16",
    "@nomicfoundation/hardhat-ignition-viem": "^0.15.17",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@nomicfoundation/hardhat-toolbox-viem": "^3.0.0",
    "@nomicfoundation/hardhat-verify": "^2.1.4",
    "@nomicfoundation/hardhat-viem": "^2.1.5",
    "@nomicfoundation/ignition-core": "^0.15.15",
    "@openzeppelin/contracts": "^5.0.2",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.11",
    "chai": "^4.5.0",
    "dotenv": "^18.0.10",
    "hardhat": "^2.30.0",
    "mocha": "^12.0.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "viem": "^2.58.6"
  }
}
