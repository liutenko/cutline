{
  "name": "cutline-data",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "test": "tsx --test \"test/*.test.ts\" --test-skip-pattern=NOPE",
    "test:offline": "tsx --test $(ls test/*.test.ts | grep -v live)",
    "test:live": "tsx --test test/cmc.live.test.ts",
    "typecheck": "tsc --noEmit",
    "record": "tsx scripts/record.ts",
    "snapshot": "tsx scripts/snapshot.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
