{
  "name": "cutline-memory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "test": "tsx --test \"test/*.test.ts\"",
    "test:offline": "tsx --test $(ls test/*.test.ts | grep -v live)",
    "test:live": "tsx --test test/memory.live.test.ts",
    "typecheck": "tsc --noEmit",
    "memory:check": "tsx scripts/check.ts",
    "memory:seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
